# Copiar este archivo a .env y rellenar con valores propios.
# Nunca subir .env al repositorio.

# --- LLM intercambiable (interfaz compatible con API de OpenAI) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=LOCAL_PLACEHOLDER
LLM_MODEL=qwen2.5:7b-instruct

# --- Evolution API ---
# EVOLUTION_BASE_URL se usa dentro de Docker (backend -> evolution).
EVOLUTION_BASE_URL=http://evolution:8080
# EVOLUTION_HOST_URL se usa desde la máquina anfitriona para el script de setup.
EVOLUTION_HOST_URL=http://localhost:8080
EVOLUTION_API_KEY=CAMBIAR_API_KEY_SEGURA
EVOLUTION_INSTANCE=jarvis
EVOLUTION_WEBHOOK_URL=http://backend:8000/webhook/evolution
# Opcional: número propio con código de país, solo si quieres fijarlo al crear la instancia.
# EVOLUTION_NUMBER=573000000000

# --- Seguridad ---
ALLOWED_NUMBERS=573000000000
MAX_MESSAGES_PER_MINUTE=10
MAX_MESSAGE_CHARS=4000
MAX_TOOL_ITERATIONS=6
# Déjalo vacío en desarrollo. En producción, define un valor aleatorio:
# el webhook exigirá la cabecera x-jarvis-secret y setup_evolution.py la
# configurará en Evolution API v2.
WEBHOOK_SECRET=
MAX_WEBHOOK_BYTES=1000000

# --- Localización y almacenamiento ---
TIMEZONE=America/Bogota
WEBHOOK_PATH=/webhook/evolution
DB_PATH=data/jarvis.db

# --- Memoria y resúmenes automáticos ---
SUMMARY_MESSAGE_THRESHOLD=30
SUMMARY_TOKEN_THRESHOLD=4000
KEEP_RECENT_MESSAGES=10

# --- Notas de voz ---
VOICE_ENABLED=true
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Responder con audio es opcional y requiere pyttsx3 instalado (+ espeak en Linux).
# Si falla el TTS local, Jarvis responde por texto. Los códigos CONFIRMAR van siempre en texto.
REPLY_WITH_AUDIO=false

# --- Simulador de terminal ---
SIM_PHONE=573000000000

# --- Base de datos del puente (nombres del compose oficial de Evolution API) ---
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO
POSTGRES_DATABASE=evolution
